{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./apps/web/*", "./libs/web/*"],
      "@devpulse/shared-types": ["./libs/shared/types/src/index.ts"],
      "@devpulse/web-shared-ui": ["./libs/web/shared/ui/src/index.ts"],
      "@devpulse/backend-users": ["./libs/backend/users/src/index.ts"],
      "@devpulse/backend-core": ["./libs/backend/core/src/index.ts"],
      "@devpulse/backend-auth": ["./libs/backend/auth/src/index.ts"],
      "@devpulse/shared-utils": ["./libs/shared/utils/src/index.ts"],
      "@devpulse/shared-ui": ["./libs/shared/ui/src/index.ts"],
      "@devpulse/auth-api": ["./libs/auth/api/src/index.ts"],
      "@devpulse/auth-feature": ["./libs/auth/feature/src/index.ts"],
      "@devpulse/backend-database": ["./libs/backend/database/src/index.ts"]
    }
  },
  "include": [
    "apps/web/next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
